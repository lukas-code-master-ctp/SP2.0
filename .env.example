# Base de datos Postgres. En local puede ser un proyecto de Supabase (gratis) o un Postgres propio.
# Supabase > Project Settings > Database > Connection string
# Con pooler (puerto 6543), para la web y el motor:
DATABASE_URL="postgresql://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Directa (puerto 5432), para migraciones:
DIRECT_URL="postgresql://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-123456"

# URL pública de la app (se usa en links de correos y retorno del pago)
APP_URL="http://localhost:3000"

# Proveedor de pagos: "mock" (simulado) | "flow" | "webpay" (fase 2)
PAYMENT_PROVIDER="mock"

# Proveedor de correo: "console" (log en terminal) | "resend" (fase 2)
EMAIL_PROVIDER="console"

# OpenRouter (fase 3: generación de informes)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"

# Obtención de documentos
WORKER_INLINE="true"             # local: la web procesa la cola. Producción (Vercel): "false" y el motor corre aparte
WORKER_CONCURRENCY="4"           # motor: cuántos documentos obtiene a la vez
COMPANY_NAME=""                  # datos del solicitante que el agente usa en los formularios (p. ej. SERVIU)
COMPANY_RUT=""                   # RUT de la empresa, ej. 76.123.456-7
COMPANY_EMAIL=""                 # correo donde llegan los certificados que se envían por correo
COMPANY_REP_NAME=""              # representante (persona natural) para sitios que rechazan el RUT de empresa
COMPANY_REP_RUN=""               # su RUN, ej. 12.345.678-9
COMPANY_REP_DOC=""               # número de documento (serie) de su cédula: lo pide el Registro Civil
# Proxy residencial chileno para emisores que bloquean datacenters. Vacío = sin proxy.
PROXY_CL_URL=""                  # http://usuario:clave@host:puerto
PROXY_CL_DOCS=""                 # opcional: códigos separados por coma (por defecto ninguno)
STORAGE_DRIVER="local"           # "local" (carpeta STORAGE_DIR) o "supabase"
STORAGE_DIR="storage"            # carpeta donde se guarda una subcarpeta por solicitud
SUPABASE_URL=""                  # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=""     # Project Settings > API Keys > Secret keys (sb_secret_..., solo servidor)
SUPABASE_BUCKET="documentos"     # bucket privado
CONNECTORS_HEADLESS="true"       # "false" muestra el navegador mientras trabaja un conector
CHROMIUM_PATH=""                 # opcional: ruta a un Chromium propio en vez del de Playwright
